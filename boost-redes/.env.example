# ============================================================
# Boost tus Redes — variables de entorno
# Copiá este archivo a .env.local y completá los valores.
# Sin estos valores la app corre en MODO DEMO (datos en memoria + pago simulado).
# ============================================================

# --- App ---
# URL pública de la app (se usa para las URLs de retorno de MercadoPago)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (base de datos) ---
# Panel de Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SECRETO, solo se usa en el servidor)
SUPABASE_SERVICE_ROLE_KEY=

# --- MercadoPago (pagos) ---
# Panel de MercadoPago -> Tus integraciones -> Credenciales
# Usá las credenciales de PRUEBA primero (TEST-...)
MERCADOPAGO_ACCESS_TOKEN=
# (opcional) firma del webhook para validar notificaciones
MERCADOPAGO_WEBHOOK_SECRET=

# --- Precios ---
# Monto mínimo para boostear (en ARS)
NEXT_PUBLIC_MIN_BOOST_ARS=500

# --- Clics ---
# Ventana de deduplicación de clics por visitante, en segundos (default 1h).
# Un mismo visitante (IP + sesión) suma como máximo 1 clic por perfil por ventana.
CLICK_DEDUP_WINDOW_SECONDS=3600
